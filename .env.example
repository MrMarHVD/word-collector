# Copy to .env and fill in. Real environment variables override these.

# Runtime
NODE_ENV=development
PORT=3000

# Allowed browser origin for the frontend (CORS).
CORS_ORIGIN=http://localhost:5173

# Session signing secret. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Admin provisioning (used only by `npm run provision:admin -w backend`).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Error monitoring (optional). Leave SENTRY_DSN blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# HSTS max-age in seconds, emitted only in production (default 180 days).
# HSTS_MAX_AGE_SECONDS=15552000

# Transactional email (Resend). Leave RESEND_API_KEY blank to log emails to the
# console instead of sending them (local dev / CI). For deliverability, verify
# your domain in Resend and add the SPF + DKIM DNS records it provides, then set
# EMAIL_FROM to an address on that domain.
RESEND_API_KEY=
EMAIL_FROM=Supergloss <onboarding@resend.dev>
EMAIL_REPLY_TO=
# Base URL used to build links in emails. Defaults to CORS_ORIGIN in dev.
APP_URL=http://localhost:5173

# --- Reserved for later phases (not yet used) ---
# DATABASE_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
