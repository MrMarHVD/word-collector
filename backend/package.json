    "import:wikdict-en-zh": "node scripts/import_wikdict_en_zh.js",
    "import:wikdict-es-en": "node scripts/import_wikdict_romance_en.js spanish",
    "import:doozan-es-en": "node scripts/import_doozan_es_en.js",
    "import:wikdict-fr-en": "node scripts/import_wikdict_romance_en.js french",
