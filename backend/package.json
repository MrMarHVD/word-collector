  "engines": {
    "node": ">=25"
  },
  "dependencies": {
    "@sentry/node": "^10.55.0",
    "jszip": "^3.10.1",
    "kuromoji": "^0.1.2",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^8.0.11",
